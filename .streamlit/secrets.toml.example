# Copy this file to .streamlit/secrets.toml (same folder) and fill in your
# Supabase project's values. NEVER commit the real secrets.toml - it is
# already in .gitignore. On Streamlit Cloud, paste the same three lines into
# the app's Settings -> Secrets box instead.

# Use the "anon" public key, NOT service_role. service_role bypasses row-level
# security, so a leak exposes the entire database. Enable RLS and add policies
# instead - see docs/deployment.md.

[supabase]
url = "https://YOUR-PROJECT-ref.supabase.co"
key = "YOUR-anon-PUBLIC-KEY"
