# Copy this file to .streamlit/secrets.toml (same folder) and fill in your
# Supabase project's values. NEVER commit the real secrets.toml - it is
# already in .gitignore. On Streamlit Cloud, paste the same three lines into
# the app's Settings -> Secrets box instead.

# Use the PUBLISHABLE key (sb_publishable_...), never the secret one
# (sb_secret_...). Supabase has deprecated the legacy anon / service_role JWT
# keys; publishable replaces anon and is the client-safe one that still obeys
# row-level security. The secret key bypasses RLS entirely - a leak exposes the
# whole database. Enable RLS and add policies instead: see docs/deployment.md.

[supabase]
url = "https://YOUR-PROJECT-ref.supabase.co"
key = "sb_publishable_YOUR-KEY-HERE"
